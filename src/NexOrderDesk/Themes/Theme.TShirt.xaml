<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Category theme: TShirt -->
  <SolidColorBrush x:Key="AccentBrush" Color="#FFC914"/>
  <SolidColorBrush x:Key="AccentLightBrush" Color="#FFE680"/>
  <SolidColorBrush x:Key="AccentDarkBrush" Color="#F2A900"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFF6D1"/>
  <SolidColorBrush x:Key="AccentTintBrush" Color="#FFE27A"/>
  <SolidColorBrush x:Key="OnAccentBrush" Color="#1E1E1E"/>
  <SolidColorBrush x:Key="OnAccentTintBrush" Color="#1E1E1E"/>
  <SolidColorBrush x:Key="OnAccentLightBrush" Color="#1E1E1E"/>
  <SolidColorBrush x:Key="OnBannerBrush" Color="#1E1E1E"/>
  <LinearGradientBrush x:Key="BannerBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#FFE680" Offset="0"/>
    <GradientStop Color="#FFC914" Offset="0.12"/>
    <GradientStop Color="#FFC914" Offset="0.8"/>
    <GradientStop Color="#F2A900" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="SheetBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFF" Offset="0"/>
    <GradientStop Color="#FFFFFF" Offset="0.7"/>
    <GradientStop Color="#FFF6D1" Offset="1"/>
  </LinearGradientBrush>
</ResourceDictionary>
