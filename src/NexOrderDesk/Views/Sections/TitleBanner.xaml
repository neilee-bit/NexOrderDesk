<UserControl x:Class="NexOrderDesk.Views.Sections.TitleBanner" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:NexOrderDesk.Views.Sections" xmlns:m="clr-namespace:NexOrderDesk.Models" xmlns:h="clr-namespace:NexOrderDesk.Core">
  <Grid Background="{DynamicResource BannerBrush}">
    <!-- order type icon -->
    <!-- order type icon: click it (while editing) to upload your own icon for this order type -->
    <Border HorizontalAlignment="Left" Margin="44,0,0,0" Width="34" Height="34" Background="Transparent" Cursor="Hand"
            ToolTip="Click to upload your own icon for this order type (PNG, JPG, SVG, ICO…)" MouseLeftButtonUp="OnIconClick"
            IsHitTestVisible="{Binding IsEditable}">
      <Viewbox>
        <Grid><Path Data="{Binding Icon}" Fill="{DynamicResource OnBannerBrush}" Visibility="{Binding NoIconImage, Converter={StaticResource BoolToVis}}"/>
              <Image Source="{Binding IconImage}" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasIconImage, Converter={StaticResource BoolToVis}}"/></Grid>
      </Viewbox>
    </Border>
    <Rectangle Width="2" Height="26" Fill="{DynamicResource OnBannerBrush}" HorizontalAlignment="Left" Margin="108,0,0,0"/>
    <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly" Stretch="Uniform" Width="590" Margin="124,0,0,0">
      <TextBlock Text="{Binding SheetTitle}" FontSize="30" FontWeight="ExtraBold" Foreground="{DynamicResource OnBannerBrush}"
                 VerticalAlignment="Center"/>
    </Viewbox>
    <!-- Last submitted order number: top right, faint -->
    <TextBlock Text="{Binding LastOrderText}" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource OnBannerBrush}" Opacity="0.5"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,8,0" Panel.ZIndex="5"/>
    <!-- Diagonal stripes -->
    <Canvas Width="150" HorizontalAlignment="Right" ClipToBounds="True">
      <Polygon Points="40,46 78,0 96,0 58,46" Fill="White" Opacity="0.35"/>
      <Polygon Points="70,46 108,0 124,0 86,46" Fill="White" Opacity="0.75"/>
      <Polygon Points="100,46 138,0 160,0 122,46" Fill="White" Opacity="0.5"/>
    </Canvas>

    <!-- Theme colour of this order (hidden after Submit / in print + PDF) -->
    <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,5" Panel.ZIndex="6">
      <Grid.Style>
        <Style TargetType="Grid"><Style.Triggers><Trigger Property="h:OutputMode.IsActive" Value="True"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
      </Grid.Style>
      <ToggleButton x:Name="ColorToggle" Width="22" Height="22" Cursor="Hand" ToolTip="Theme colour of this order">
        <ToggleButton.Template>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" CornerRadius="11" Background="#CCFFFFFF" BorderBrush="#1E1E1E" BorderThickness="1">
              <Viewbox Width="13" Height="13">
                <!-- palette icon -->
                <Path Data="M12,2 C6.5,2 2,6.1 2,11.2 C2,15.6 5.4,19 9.4,19 L11,19 C12,19 12.6,19.8 12.3,20.7 C12,21.5 12.6,22 13.4,22 C18.7,21.6 22,17 22,11.6 C22,6.3 17.5,2 12,2 Z M6.5,12 A1.5,1.5 0 1 1 6.5,9 A1.5,1.5 0 1 1 6.5,12 Z M9.5,8 A1.5,1.5 0 1 1 9.5,5 A1.5,1.5 0 1 1 9.5,8 Z M14.5,8 A1.5,1.5 0 1 1 14.5,5 A1.5,1.5 0 1 1 14.5,8 Z M17.5,12 A1.5,1.5 0 1 1 17.5,9 A1.5,1.5 0 1 1 17.5,12 Z"
                      Fill="#1E1E1E"/>
              </Viewbox>
            </Border>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="White"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate>
        </ToggleButton.Template>
      </ToggleButton>
      <Popup x:Name="ColorPopup" IsOpen="{Binding IsChecked, ElementName=ColorToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=ColorToggle}"
             Placement="Bottom" HorizontalOffset="-200" StaysOpen="False" AllowsTransparency="True" Opened="OnPopupOpened">
        <Border Background="White" CornerRadius="9" Padding="12" Margin="0,4,10,10" Width="236" Effect="{StaticResource SoftShadow}" BorderBrush="#E2E4E8" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="THEME COLOUR — THIS ORDER" FontSize="9.5" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,8"/>
            <ItemsControl x:Name="Palette">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Width="22" Height="22" Margin="0,0,4,4" Cursor="Hand" Tag="{Binding}" Click="OnSwatch" ToolTip="{Binding}">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="11" BorderBrush="#C8C8C8" BorderThickness="1" Background="{Binding}"/>
                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#1E1E1E"/></Trigger></ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <TextBlock Text="Custom" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0"/>
              <TextBox x:Name="HexBox" Width="82" Height="24" FontSize="12" VerticalContentAlignment="Center" Padding="4,0"/>
              <Button Content="Apply" Height="24" Padding="10,0" Margin="6,0,0,0" Click="OnApplyHex" Style="{StaticResource ActionButton}" FontSize="11"/>
            </StackPanel>
            <Button Content="Reset to the order type colour" Height="24" Margin="0,10,0,0" Click="OnReset" Style="{StaticResource ActionButton}" FontSize="11"/>
            <Button x:Name="SaveDefault" Content="Save as default for this order type" Height="24" Margin="0,6,0,0" Click="OnSaveDefault"
                    Style="{StaticResource ActionButton}" FontSize="11" ToolTip="Every new order of this type will use this colour"/>
          </StackPanel>
        </Border>
      </Popup>
    </Grid>
  </Grid>
</UserControl>
