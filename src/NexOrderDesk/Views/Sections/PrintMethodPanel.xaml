<UserControl x:Class="NexOrderDesk.Views.Sections.PrintMethodPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:NexOrderDesk.Views.Sections" xmlns:m="clr-namespace:NexOrderDesk.Models" xmlns:h="clr-namespace:NexOrderDesk.Core">
  <!-- Compact="True" (bottoms / shorts): thinner header, smaller pills in 4 columns -->
  <Border Style="{StaticResource Card}" Padding="8,5">
    <Border.Resources>
      <ItemsPanelTemplate x:Key="ThreeCols"><UniformGrid Columns="3"/></ItemsPanelTemplate>
      <ItemsPanelTemplate x:Key="FourCols"><UniformGrid Columns="4"/></ItemsPanelTemplate>
    </Border.Resources>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="4"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border CornerRadius="5" Background="{DynamicResource AccentBrush}">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Height" Value="24"/>
            <Style.Triggers><DataTrigger Binding="{Binding Compact, RelativeSource={RelativeSource AncestorType=s:PrintMethodPanel}}" Value="True"><Setter Property="Height" Value="17"/></DataTrigger></Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Viewbox StretchDirection="DownOnly" Margin="26,0">
            <TextBlock Text="{Binding PrintSummary}" FontSize="17" FontWeight="ExtraBold" Foreground="#1E1E1E"/>
          </Viewbox>
          <Button Content="&#x2699;" Width="16" Height="15" HorizontalAlignment="Right" Margin="0,0,4,0" FontSize="10"
                  Click="OnManage" ToolTip="Add / rename / remove print types">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                <Style.Triggers><Trigger Property="h:OutputMode.IsActive" Value="True"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </Grid>
      </Border>
      <ItemsControl Grid.Row="2" ItemsSource="{Binding PrintMethodsView}">
        <ItemsControl.Style>
          <Style TargetType="ItemsControl">
            <Setter Property="ItemsPanel" Value="{StaticResource ThreeCols}"/>
            <Style.Triggers><DataTrigger Binding="{Binding Compact, RelativeSource={RelativeSource AncestorType=s:PrintMethodPanel}}" Value="True"><Setter Property="ItemsPanel" Value="{StaticResource FourCols}"/></DataTrigger></Style.Triggers>
          </Style>
        </ItemsControl.Style>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type m:PrintMethodOption}">
            <ToggleButton Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" ToolTip="Select up to 2 print types">
              <ToggleButton.Style>
                <Style TargetType="ToggleButton" BasedOn="{StaticResource PillToggle}">
                  <Setter Property="Margin" Value="0,0,4,3"/><Setter Property="FontSize" Value="9"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Compact, RelativeSource={RelativeSource AncestorType=s:PrintMethodPanel}}" Value="True">
                      <Setter Property="FontSize" Value="7.5"/><Setter Property="Height" Value="15"/><Setter Property="Margin" Value="0,0,3,2"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ToggleButton.Style>
            </ToggleButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Border>
</UserControl>
