<UserControl x:Class="NexOrderDesk.Views.Sections.PrintMethodPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:NexOrderDesk.Views.Sections" xmlns:m="clr-namespace:NexOrderDesk.Models" xmlns:h="clr-namespace:NexOrderDesk.Core">
  <!-- Compact="True" (bottoms / shorts): thinner header, smaller pills in 4 columns -->
  <Grid>
  <!-- ===== editing: title + print-type buttons (2.9.1: this card owns its minimum height, not the sheet row) ===== -->
  <Border Padding="8,5">
    <Border.Style>
      <Style TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="MinHeight" Value="64"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Compact, RelativeSource={RelativeSource AncestorType=s:PrintMethodPanel}}" Value="True"><Setter Property="MinHeight" Value="48"/></DataTrigger>
          <Trigger Property="h:OutputMode.IsActive" Value="True"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
    <Border.Resources>
      <!-- 2.9.1: shared option grid - columns from the real text widths, rows added automatically, nothing cut off -->
      <ItemsPanelTemplate x:Key="Grid4"><h:OptionGrid MaxColumns="4" MinCellWidth="64" MinCellHeight="22" Gap="4"/></ItemsPanelTemplate>
      <ItemsPanelTemplate x:Key="Grid4Compact"><h:OptionGrid MaxColumns="4" MinCellWidth="56" MinCellHeight="19" Gap="3"/></ItemsPanelTemplate>
      <Style x:Key="PrintPill" TargetType="ToggleButton" BasedOn="{StaticResource OptionCard}">
        <Setter Property="FontSize" Value="10.5"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Compact, RelativeSource={RelativeSource AncestorType=s:PrintMethodPanel}}" Value="True">
            <Setter Property="FontSize" Value="9"/><Setter Property="Padding" Value="5,2"/><Setter Property="MinHeight" Value="18"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Resources>
    <Grid>
      <!-- 2.9: the print-type buttons fill all the space below the title (bigger click areas) -->
      <!-- 2.9.1: the box is as tall as its options need (rows added automatically) -->
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="4"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border CornerRadius="5" Background="{DynamicResource AccentBrush}">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Height" Value="24"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Compact, RelativeSource={RelativeSource AncestorType=s:PrintMethodPanel}}" Value="True"><Setter Property="Height" Value="17"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Viewbox Margin="26,0" StretchDirection="DownOnly">
            <TextBlock Text="{Binding PrintSummary}" FontSize="17" FontWeight="ExtraBold" Foreground="{DynamicResource OnAccentBrush}"/>
          </Viewbox>
          <Button Content="&#x2699;" Width="16" Height="15" HorizontalAlignment="Right" Margin="0,0,4,0" FontSize="10"
                  Click="OnManage" ToolTip="Add / rename / remove print types">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ActionButton}"/></Button.Style>
          </Button>
        </Grid>
      </Border>
      <ItemsControl Grid.Row="2" ItemsSource="{Binding PrintGridItems}">
        <ItemsControl.Style>
          <Style TargetType="ItemsControl">
            <Setter Property="ItemsPanel" Value="{StaticResource Grid4}"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Compact, RelativeSource={RelativeSource AncestorType=s:PrintMethodPanel}}" Value="True"><Setter Property="ItemsPanel" Value="{StaticResource Grid4Compact}"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </ItemsControl.Style>
        <ItemsControl.Resources>
          <!-- one print type -->
          <DataTemplate DataType="{x:Type m:PrintMethodOption}">
            <ToggleButton Style="{StaticResource PrintPill}" Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          ToolTip="{Binding Name}"/>
          </DataTemplate>
          <!-- second level: the other print types -->
          <DataTemplate DataType="{x:Type m:MorePrintMethods}">
            <Grid>
              <ToggleButton x:Name="MoreButton" Style="{StaticResource PrintPill}" Content="{Binding Text}" IsChecked="{Binding IsOpen, Mode=TwoWay}"
                            ToolTip="More print types"/>
              <Popup PlacementTarget="{Binding ElementName=MoreButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                     IsOpen="{Binding IsOpen, Mode=TwoWay}" PopupAnimation="Fade">
                <Border Background="White" BorderBrush="#E2E4E8" BorderThickness="1" CornerRadius="9" Padding="8" Margin="0,3,10,10"
                        Effect="{StaticResource SoftShadow}" MinWidth="220" MaxWidth="420">
                  <StackPanel>
                    <TextBlock Text="MORE PRINT TYPES - select up to 2 in total" FontSize="9" FontWeight="Bold" Foreground="#8A8F98" Margin="2,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><h:OptionGrid MaxColumns="2" MinCellWidth="110" MinCellHeight="26" Gap="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:PrintMethodOption}">
                          <ToggleButton Style="{StaticResource OptionCard}" Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                        FontSize="11" ToolTip="{Binding Name}"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </Popup>
            </Grid>
          </DataTemplate>
        </ItemsControl.Resources>
      </ItemsControl>
    </Grid>
  </Border>

  <!-- ===== submitted sheet / print / PDF (2.9.1): one compact accent row with just the chosen method(s),
       e.g. FULL SUBLIMATION - no "printing method" caption. Long names wrap to a second line, no big box. ===== -->
  <Border MinHeight="28" CornerRadius="14" Background="{DynamicResource AccentBrush}">
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers><Trigger Property="h:OutputMode.IsActive" Value="True"><Setter Property="Visibility" Value="Visible"/></Trigger></Style.Triggers>
      </Style>
    </Border.Style>
    <TextBlock x:Name="SubmittedMethod" Text="{Binding PrintSummary}" FontSize="12.5" FontWeight="ExtraBold" Foreground="{DynamicResource OnAccentBrush}"
               TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="12,4"/>
  </Border>
  </Grid>
</UserControl>
