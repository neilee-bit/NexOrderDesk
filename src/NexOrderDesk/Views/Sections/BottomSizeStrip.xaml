<UserControl x:Class="NexOrderDesk.Views.Sections.BottomSizeStrip" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:NexOrderDesk.Views.Sections" xmlns:m="clr-namespace:NexOrderDesk.Models" xmlns:h="clr-namespace:NexOrderDesk.Core">
  <!-- Bottoms / shorts size breakdown: sizes left-to-right, total beside them. Compact: ~80 units high. -->
  <UserControl.Resources>
    <Style x:Key="LabelBox" TargetType="TextBox" BasedOn="{StaticResource CellBox}">
      <Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="#000000"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#9AA0A9"/><Setter Property="Margin" Value="3,1"/>
      <Style.Triggers><Trigger Property="h:OutputMode.IsActive" Value="True"><Setter Property="BorderThickness" Value="0"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Height" Value="16"/><Setter Property="FontSize" Value="8.5"/><Setter Property="Padding" Value="5,0"/>
      <Style.Triggers><Trigger Property="h:OutputMode.IsActive" Value="True"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Border Style="{StaticResource Card}" Height="100">
    <Grid Margin="0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <!-- title row -->
      <Border Grid.ColumnSpan="2" Background="{DynamicResource AccentTintBrush}" CornerRadius="9,9,0,0"/>
      <DockPanel Margin="10,0,6,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                    Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}">
          <ToggleButton Style="{StaticResource PillToggle}" Content="{Binding ExtraSizesText}" Width="72" Height="15" FontSize="8"
                        IsChecked="{Binding IncludeExtraSizes, Mode=TwoWay}" ToolTip="{Binding ExtraSizesTip}"/>
          <Button Style="{StaticResource SmallBtn}" Content="+ size" Margin="4,0,0,0" Command="{Binding AddOptionalSizeCommand}"
                  ToolTip="Add another optional size" Visibility="{Binding IncludeExtraSizes, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
        <TextBlock Text="SIZE BREAKDOWN" FontSize="10.5" FontWeight="ExtraBold" VerticalAlignment="Center"/>
      </DockPanel>

      <!-- sizes side by side -->
      <!-- submitted: only filled sizes, normal cell width, right next to the total (BottomStripCompact) -->
      <ItemsControl Grid.Row="1" ItemsSource="{Binding BottomStripView}" Margin="6,4,6,6"
                    Width="{Binding BottomStripWidth}">
        <ItemsControl.Style>
          <Style TargetType="ItemsControl">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding BottomStripCompact}" Value="True"><Setter Property="HorizontalAlignment" Value="Right"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </ItemsControl.Style>
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type m:SizeEntry}">
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Margin="0">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="#F3F4F6" CornerRadius="3" Margin="2,0"/>
                <Viewbox StretchDirection="DownOnly" Margin="2,0" Visibility="{Binding IsCustom, Converter={StaticResource InvBoolToVis}}">
                  <TextBlock Text="{Binding Label}" FontSize="10.5" FontWeight="Bold" Foreground="#000000"/>
                </Viewbox>
                <TextBox Style="{StaticResource LabelBox}" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" ToolTip="Type the size (e.g. 5XL, 28, 30)"
                         Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"/>
                <TextBox Grid.Row="1" Style="{StaticResource CellBox}" FontSize="16" Text="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}" Validation.ErrorTemplate="{x:Null}"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- total beside the sizes -->
      <Border Grid.Column="1" Grid.RowSpan="2" Background="{DynamicResource AccentBrush}" CornerRadius="0,9,9,0">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="TOTAL" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#1E1E1E"/>
          <Viewbox StretchDirection="DownOnly" Margin="4,0">
            <TextBlock Text="{Binding TotalQuantity}" FontSize="26" FontWeight="ExtraBold" HorizontalAlignment="Center" Foreground="#1E1E1E"/>
          </Viewbox>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
