<UserControl x:Class="NexOrderDesk.Views.Sections.JacketSpecsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:NexOrderDesk.Views.Sections" xmlns:m="clr-namespace:NexOrderDesk.Models" xmlns:h="clr-namespace:NexOrderDesk.Core">
  <!-- JACKET sheet specs: Jacket type, Collar (Hooded is highlighted), Sleeve &amp; cuff, Closure, Pocket type (tick several),
       Additional customisation (tick boxes). Every list is add/editable. After Submit only the ticked options are shown. -->
  <UserControl.Resources>
    <Style x:Key="ChipToggle" TargetType="ToggleButton">
      <Setter Property="FontSize" Value="8.5"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,3,3"/><Setter Property="Height" Value="16"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" CornerRadius="8" Background="#F6F6F6" BorderBrush="#DCDCDC" BorderThickness="1" Padding="4,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="Box" Width="8" Height="8" CornerRadius="2" BorderBrush="#9AA0A9" BorderThickness="1" Margin="0,0,3,0" VerticalAlignment="Center">
                <Path x:Name="Tick" Data="M0.5,4 L3,6.5 L7.5,1" Stroke="#1E1E1E" StrokeThickness="1.4" Visibility="Collapsed" Stretch="Uniform"/>
              </Border>
              <!-- long names shrink to fit the chip -->
              <Viewbox Grid.Column="1" StretchDirection="DownOnly" HorizontalAlignment="Center"><ContentPresenter VerticalAlignment="Center"/></Viewbox>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#EBEBEB"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentDarkBrush}"/>
              <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="#1E1E1E"/>
            </Trigger>
            <!-- output: just the name, no tick box -->
            <Trigger Property="h:OutputMode.IsActive" Value="True">
              <Setter TargetName="Box" Property="Visibility" Value="Collapsed"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="MiniGear" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Width" Value="16"/><Setter Property="Height" Value="14"/><Setter Property="FontSize" Value="9"/>
      <Style.Triggers><Trigger Property="h:OutputMode.IsActive" Value="True"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Border Style="{StaticResource Card}" Padding="8,4">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="0.36*"/><ColumnDefinition Width="0.64*"/></Grid.ColumnDefinitions>

      <Label Grid.Row="0" Content="Jacket Type:" Style="{StaticResource SpecLabel}"/>
      <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FlatCombo}" BorderBrush="{StaticResource LineBrush}" FontWeight="Bold"
                h:ComboHelper.ManageKey="jackettypes" ItemsSource="{Binding Settings.JacketTypes}" SelectedItem="{Binding JacketType}"/>

      <!-- Collar: highlighted when Hooded -->
      <Border Grid.Row="1" Grid.ColumnSpan="2" CornerRadius="8" Margin="-4,0" IsHitTestVisible="False">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsHooded}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers>
          </Style>
        </Border.Style>
      </Border>
      <Label Grid.Row="1" Content="Collar:" Style="{StaticResource SpecLabel}"/>
      <ComboBox Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource LineBrush}"
                h:ComboHelper.ManageKey="jacketcollars" ItemsSource="{Binding Settings.JacketCollars}" SelectedItem="{Binding JacketCollar}">
        <ComboBox.Style>
          <Style TargetType="ComboBox" BasedOn="{StaticResource FlatCombo}">
            <Style.Triggers><DataTrigger Binding="{Binding IsHooded}" Value="True"><Setter Property="FontWeight" Value="ExtraBold"/><Setter Property="FontSize" Value="12"/></DataTrigger></Style.Triggers>
          </Style>
        </ComboBox.Style>
      </ComboBox>

      <Label Grid.Row="2" Style="{StaticResource SpecLabel}">
        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="Sleeve &amp; Cuff:" VerticalAlignment="Center"/></Viewbox>
      </Label>
      <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FlatCombo}" BorderBrush="{StaticResource LineBrush}"
                h:ComboHelper.ManageKey="jacketsleeves" ItemsSource="{Binding Settings.JacketSleeves}" SelectedItem="{Binding JacketSleeve}"/>

      <Label Grid.Row="3" Content="Closure:" Style="{StaticResource SpecLabel}"/>
      <ComboBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FlatCombo}" BorderBrush="{StaticResource LineBrush}"
                h:ComboHelper.ManageKey="jacketclosures" ItemsSource="{Binding Settings.JacketClosures}" SelectedItem="{Binding JacketClosure}"/>

      <Label Grid.Row="4" Content="Pocket Type:" Style="{StaticResource SpecLabel}"/>
      <!-- multi-select drop-down: tick one or more pocket types -->
      <Grid Grid.Row="4" Grid.Column="1">
        <ToggleButton x:Name="JPocketToggle" Cursor="Hand" ToolTip="Tick one or more pocket types">
          <ToggleButton.Template>
            <ControlTemplate TargetType="ToggleButton">
              <Border Background="Transparent" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="4,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding JacketPocketSummary}" FontSize="11" Foreground="{StaticResource TextBrush}"/>
                  </Viewbox>
                  <Path x:Name="Arrow" Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="{StaticResource TextBrush}" StrokeThickness="1.5" Margin="6,0,2,0" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="h:OutputMode.IsActive" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Collapsed"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </ToggleButton.Template>
        </ToggleButton>
        <Popup IsOpen="{Binding IsChecked, ElementName=JPocketToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=JPocketToggle}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
          <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Margin="0,2,6,8"
                  MinWidth="{Binding ActualWidth, ElementName=JPocketToggle}" Effect="{StaticResource SoftShadow}">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding JacketPockets}" Margin="4">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type m:CheckOption}">
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" FontSize="11" Margin="4,3" Cursor="Hand"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <Button Content="+ Add / edit list…" Click="OnManagePockets" Padding="8,5" FontSize="10" FontWeight="SemiBold"
                        Cursor="Hand" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left"
                        Foreground="{DynamicResource AccentDarkBrush}"/>
              </Border>
            </StackPanel>
          </Border>
        </Popup>
      </Grid>


      <!-- Additional customisation: tick boxes -->
      <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,3,0,0">
        <DockPanel Margin="0,0,0,2">
          <Button DockPanel.Dock="Right" Style="{StaticResource MiniGear}" Content="&#x2699;" Click="OnManageExtras" ToolTip="Add / rename / remove customisation options"/>
          <Label Content="Additional Customisation:" Style="{StaticResource SpecLabel}" Height="16" FontSize="10" HorizontalAlignment="Left" Margin="0"/>
          <TextBlock Text="None" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"
                     Visibility="{Binding ShowNoJacketExtras, Converter={StaticResource BoolToVis}}"/>
        </DockPanel>
        <ItemsControl ItemsSource="{Binding JacketExtrasView}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type m:CheckOption}">
              <ToggleButton Style="{StaticResource ChipToggle}" Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" ToolTip="{Binding Name}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
