<UserControl x:Class="NexOrderDesk.Views.Sections.OrderSheetView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:NexOrderDesk.Views.Sections" xmlns:m="clr-namespace:NexOrderDesk.Models" xmlns:h="clr-namespace:NexOrderDesk.Core"
             h:OutputMode.IsActive="{Binding IsEditable, Converter={StaticResource InvBool}}">
  <Grid>
    <Grid.RowDefinitions>
      <!-- 2.9: small button row; on the printed sheet / PDF it is removed completely so the order gets the space -->
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- FRONT side -->
    <Grid Visibility="{Binding IsBackSide, Converter={StaticResource InvBoolToVis}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="46"/><RowDefinition Height="6"/><RowDefinition Height="46"/><RowDefinition Height="8"/><RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <s:TitleBanner/>
      <s:OrderHeaderBar Grid.Row="2" Margin="10,0" IsHitTestVisible="{Binding IsEditable}"/>

      <!-- ============ TOPS (T-shirt, jacket, cut & print, print & press) ============ -->
      <Grid Grid.Row="4" Margin="10,0" IsHitTestVisible="{Binding IsEditable}" Visibility="{Binding IsTops, Converter={StaticResource BoolToVis}}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="49*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="51*"/></Grid.ColumnDefinitions>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="180*"/><RowDefinition Height="6"/><RowDefinition Height="Auto" MinHeight="28"/><RowDefinition Height="6"/>
            <RowDefinition Height="112*"/><RowDefinition Height="6"/><RowDefinition Height="Auto" MinHeight="64"/>
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <s:ImageUploadPanel Caption="UPLOAD FRONT IMAGE" Doc="{Binding FrontImages}"/>
            <s:ImageUploadPanel Grid.Column="2" Caption="UPLOAD BACK IMAGE" Doc="{Binding BackImages}"/>
          </Grid>
          <s:MaterialColorBar Grid.Row="2"/>
          <s:GarmentSpecsPanel Grid.Row="4"/>
          <s:PrintMethodPanel Grid.Row="6"/>
        </Grid>
        <Grid Grid.Column="2">
          <Grid.RowDefinitions><RowDefinition Height="178*"/><RowDefinition Height="6"/><RowDefinition Height="256*"/></Grid.RowDefinitions>
          <s:NotesPanel/>
          <s:SizeTablePanel Grid.Row="2"/>
        </Grid>
      </Grid>

      <!-- ============ JACKETS: jacket type, collar, sleeve & cuff, closure, pockets, additional customisation ============ -->
      <Grid Grid.Row="4" Margin="10,0" IsHitTestVisible="{Binding IsEditable}" Visibility="{Binding IsJacket, Converter={StaticResource BoolToVis}}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="49*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="51*"/></Grid.ColumnDefinitions>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="160*"/><RowDefinition Height="6"/><RowDefinition Height="Auto" MinHeight="28"/><RowDefinition Height="6"/>
            <RowDefinition Height="200*"/><RowDefinition Height="6"/><RowDefinition Height="Auto" MinHeight="48"/>
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <s:ImageUploadPanel Caption="UPLOAD FRONT IMAGE" Doc="{Binding FrontImages}"/>
            <s:ImageUploadPanel Grid.Column="2" Caption="UPLOAD BACK IMAGE" Doc="{Binding BackImages}"/>
          </Grid>
          <s:MaterialColorBar Grid.Row="2"/>
          <s:JacketSpecsPanel Grid.Row="4"/>
          <s:PrintMethodPanel Grid.Row="6" Compact="True"/>
        </Grid>
        <Grid Grid.Column="2">
          <Grid.RowDefinitions><RowDefinition Height="178*"/><RowDefinition Height="6"/><RowDefinition Height="256*"/></Grid.RowDefinitions>
          <s:NotesPanel/>
          <s:SizeTablePanel Grid.Row="2"/>
        </Grid>
      </Grid>

      <!-- ============ BOTTOMS / SHORTS: prominent colour, small print panel, horizontal size strip ============ -->
      <Grid Grid.Row="4" Margin="10,0" IsHitTestVisible="{Binding IsEditable}" Visibility="{Binding IsBottoms, Converter={StaticResource BoolToVis}}">
        <!-- 2.9: sizes + notes in a compact column on the right, more width for pictures / material on the left -->
        <Grid.ColumnDefinitions><ColumnDefinition Width="58*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="42*"/></Grid.ColumnDefinitions>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="175*"/><RowDefinition Height="6"/><RowDefinition Height="Auto" MinHeight="34"/><RowDefinition Height="6"/>
            <RowDefinition Height="150*"/><RowDefinition Height="6"/><RowDefinition Height="Auto" MinHeight="48"/>
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <s:ImageUploadPanel Caption="UPLOAD FRONT IMAGE" Doc="{Binding FrontImages}"/>
            <s:ImageUploadPanel Grid.Column="2" Caption="UPLOAD BACK IMAGE" Doc="{Binding BackImages}"/>
          </Grid>
          <s:MaterialColorBar Grid.Row="2"/>
          <s:BottomSpecsPanel Grid.Row="4"/>
          <s:PrintMethodPanel Grid.Row="6" Compact="True"/>
        </Grid>
        <!-- 2.9: the same size table as the other order types (Adults + optional Kids / PS / other sizes columns) -->
        <Grid Grid.Column="2">
          <Grid.RowDefinitions><RowDefinition Height="178*"/><RowDefinition Height="6"/><RowDefinition Height="256*"/></Grid.RowDefinitions>
          <s:NotesPanel/>
          <s:SizeTablePanel Grid.Row="2"/>
        </Grid>
      </Grid>

      <!-- ============ FLAGS: artwork + flag sizes, flag material / colour bar at the bottom ============ -->
      <Grid Grid.Row="4" Margin="10,0" Visibility="{Binding IsFlags, Converter={StaticResource BoolToVis}}">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="6"/><RowDefinition Height="Auto" MinHeight="34"/></Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="47*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="53*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="6">
            <s:FreeCanvasView Doc="{Binding Workspace}" IsEditable="{Binding IsEditable}"
                              EmptyText="Flag artwork&#x0a;paste (Ctrl+V) or drop the design here&#x0a;add as many pictures and notes as you need"/>
          </Border>
          <s:FlagSizesPanel Grid.Column="2" IsHitTestVisible="{Binding IsEditable}"/>
        </Grid>
        <s:MaterialColorBar Grid.Row="2" IsHitTestVisible="{Binding IsEditable}"/>
      </Grid>

      <!-- ============ DTF: the five order fields above + one big artwork workspace ============ -->
      <s:FreeCanvasView Grid.Row="4" Margin="10,0" Doc="{Binding Workspace}" IsEditable="{Binding IsEditable}"
                        Visibility="{Binding IsDtf, Converter={StaticResource BoolToVis}}"
                        EmptyText="DTF workspace&#x0a;Ctrl+V to paste artwork or text  ·  drag &amp; drop pictures  ·  import several pictures at once&#x0a;move, resize and edit everything freely"/>
    </Grid>

    <!-- BACK side: clean form + free workspace -->
    <s:BackSheetView Visibility="{Binding IsBackSide, Converter={StaticResource BoolToVis}}"/>

    <!-- submit result (never printed) -->
    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4" CornerRadius="13" Padding="12,4" Background="#E61E1E1E" Panel.ZIndex="20">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="{Binding HasStatus, Converter={StaticResource BoolToVis}}"/>
          <Style.Triggers><Trigger Property="h:OutputMode.IsPrint" Value="True"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel Orientation="Horizontal">
        <!-- 2.9: just the message - the saved copy's location is not shown -->
        <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <s:ActionBar Grid.Row="1" Margin="0,4,0,3">
      <s:ActionBar.Style>
        <Style TargetType="s:ActionBar">
          <Style.Triggers><Trigger Property="h:OutputMode.IsPrint" Value="True"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
        </Style>
      </s:ActionBar.Style>
    </s:ActionBar>
  </Grid>
</UserControl>
