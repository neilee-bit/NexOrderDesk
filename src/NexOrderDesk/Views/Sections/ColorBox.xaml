<UserControl x:Class="NexOrderDesk.Views.Sections.ColorBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:h="clr-namespace:NexOrderDesk.Core">
  <!-- Material colour (2.9): type a colour name, the swatch is found automatically; suggestions show while typing. -->
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid Width="16" Height="16" Margin="2,0,5,0" VerticalAlignment="Center" ToolTip="{Binding ColorHint}">
      <Border CornerRadius="8" Background="{Binding ColorBrush}" BorderBrush="#C8C8C8" BorderThickness="0.8"/>
      <TextBlock Text="?" FontSize="10" FontWeight="Bold" Foreground="#9AA0A9" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Visibility="{Binding ColorFound, Converter={StaticResource InvBoolToVis}}"/>
    </Grid>
    <TextBox x:Name="Box" Grid.Column="1" Style="{StaticResource ValueBox}" FontSize="12"
             FontWeight="Bold" TextAlignment="Left" CharacterCasing="Upper" Padding="0" MinWidth="44" h:FitText.Enabled="True"
             Text="{Binding ColorName, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding ColorHint}"
             TextChanged="OnTextChanged" PreviewKeyDown="OnKeyDown" PreviewMouseLeftButtonUp="OnBoxClick"
             GotKeyboardFocus="OnGotFocus" LostKeyboardFocus="OnLostFocus"/>
    <Popup x:Name="DropPopup" PlacementTarget="{Binding ElementName=Box}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True"
           Focusable="False" PopupAnimation="Fade">
      <Border Background="White" BorderBrush="#E2E4E8" BorderThickness="1" CornerRadius="7" Margin="0,3,8,8" MinWidth="190"
              Effect="{StaticResource SoftShadow}">
        <Border.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/></Border.Resources>
        <ListBox x:Name="List" BorderThickness="0" MaxHeight="232" Focusable="False" Padding="2,2,0,2" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                 PreviewMouseLeftButtonUp="OnPick">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Focusable" Value="False"/>
              <Setter Property="Padding" Value="8,4"/>
              <Setter Property="Cursor" Value="Hand"/>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <Border Width="16" Height="16" CornerRadius="8" Background="{Binding Brush}" BorderBrush="#C8C8C8" BorderThickness="0.8" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Popup>
  </Grid>
</UserControl>
