<UserControl x:Class="NexOrderDesk.Views.Sections.OrderHeaderBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:NexOrderDesk.Views.Sections" xmlns:m="clr-namespace:NexOrderDesk.Models" xmlns:h="clr-namespace:NexOrderDesk.Core">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.0*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.15*"/>
      <ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1.45*"/>
    </Grid.ColumnDefinitions>
    <HeaderedContentControl Style="{StaticResource FieldCard}" Header="Order Number" Margin="0,0,8,0"
                            Background="{DynamicResource AccentBrush}">
      <TextBox Style="{StaticResource ValueBox}" FontSize="17" FontWeight="ExtraBold" Text="{Binding OrderNumber, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="Auto-suggested (last order + 1). Click to override."/>
    </HeaderedContentControl>
    <HeaderedContentControl Grid.Column="1" Style="{StaticResource FieldCard}" Header="Delivery Date" Margin="0,0,8,0">
      <Grid>
        <!-- The date text sits directly in the button (not in a template) and is set from code after a pick, so it always shows. -->
        <ToggleButton x:Name="DateToggle" Cursor="Hand" ToolTip="Pick delivery date" Focusable="False">
          <ToggleButton.Template>
            <ControlTemplate TargetType="ToggleButton">
              <Border Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            </ControlTemplate>
          </ToggleButton.Template>
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="DateText" Text="{Binding DeliveryText, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="#1E1E1E" VerticalAlignment="Center"/>
            <Viewbox x:Name="CalIcon" Width="11" Height="11" Margin="5,0,0,0" VerticalAlignment="Center">
              <Path Data="M3,5 H21 V21 H3 Z M3,9 H21 M7,2 V6 M17,2 V6" Stroke="#6B7280" StrokeThickness="2"/>
            </Viewbox>
          </StackPanel>
        </ToggleButton>
        <Popup x:Name="DatePopup" IsOpen="{Binding IsChecked, ElementName=DateToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=DateToggle}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Opened="OnDatePopupOpened">
          <Border Background="White" BorderBrush="#E2E4E8" BorderThickness="1" CornerRadius="9" Padding="8" Margin="0,4,10,10" Effect="{StaticResource SoftShadow}">
            <StackPanel>
              <TextBlock Text="DELIVERY DATE" FontSize="9.5" FontWeight="Bold" Foreground="#6B7280" Margin="2,0,0,6"/>
              <!-- quick picks -->
              <UniformGrid Columns="4" Margin="0,0,0,6">
                <Button Content="Today" Tag="0" Click="OnQuickDate" Style="{StaticResource ActionButton}" Height="22" FontSize="10" Margin="0,0,3,0"/>
                <Button Content="+3 days" Tag="3" Click="OnQuickDate" Style="{StaticResource ActionButton}" Height="22" FontSize="10" Margin="0,0,3,0"/>
                <Button Content="+1 week" Tag="7" Click="OnQuickDate" Style="{StaticResource ActionButton}" Height="22" FontSize="10" Margin="0,0,3,0"/>
                <Button Content="+2 weeks" Tag="14" Click="OnQuickDate" Style="{StaticResource ActionButton}" Height="22" FontSize="10"/>
              </UniformGrid>
              <Calendar x:Name="Cal" SelectionMode="SingleDate" SelectedDatesChanged="OnDateChanged" PreviewMouseUp="OnCalendarMouseUp"/>
              <TextBlock x:Name="PickedText" FontSize="11" FontWeight="SemiBold" Foreground="#1E1E1E" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
        </Popup>
      </Grid>
    </HeaderedContentControl>
    <HeaderedContentControl Grid.Column="2" Style="{StaticResource FieldCard}" Header="Order Name" Margin="0,0,8,0">
      <TextBox Style="{StaticResource ValueBox}" Text="{Binding OrderName, UpdateSourceTrigger=PropertyChanged}"/>
    </HeaderedContentControl>
    <HeaderedContentControl Grid.Column="3" Style="{StaticResource FieldCard}" Header="Customer" Margin="0,0,8,0">
      <s:CustomerBox/>
    </HeaderedContentControl>
    <HeaderedContentControl Grid.Column="4" Style="{StaticResource FieldCard}" Header="Coordinator">
      <Grid>
        <!-- editing: pick from the list -->
        <ComboBox x:Name="CoordinatorCombo" FontSize="13" FontWeight="Bold" h:ComboHelper.ManageKey="coordinators"
                  ItemsSource="{Binding Settings.Coordinators}" SelectedItem="{Binding Coordinator}">
          <ComboBox.Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource FlatCombo}">
              <Style.Triggers><Trigger Property="h:OutputMode.IsActive" Value="True"><Setter Property="Visibility" Value="Hidden"/></Trigger></Style.Triggers>
            </Style>
          </ComboBox.Style>
        </ComboBox>
        <!-- submitted sheet / print / PDF: the saved coordinator name itself, so it always shows -->
        <Viewbox StretchDirection="DownOnly" Margin="4,0">
          <TextBlock x:Name="CoordinatorText" Text="{Binding Coordinator}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                     VerticalAlignment="Center"/>
          <Viewbox.Style>
            <Style TargetType="Viewbox">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers><Trigger Property="h:OutputMode.IsActive" Value="True"><Setter Property="Visibility" Value="Visible"/></Trigger></Style.Triggers>
            </Style>
          </Viewbox.Style>
        </Viewbox>
      </Grid>
    </HeaderedContentControl>
  </Grid>
</UserControl>
