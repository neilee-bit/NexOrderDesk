<UserControl x:Class="NexOrderDesk.Views.Sections.SizeTablePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:NexOrderDesk.Views.Sections" xmlns:m="clr-namespace:NexOrderDesk.Models" xmlns:h="clr-namespace:NexOrderDesk.Core">
  <UserControl.Resources>
    <Style x:Key="SizeLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#000000"/>
      <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="TableHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#000000"/>
      <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="RowBorder" TargetType="Border">
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="0,0,0,0.6"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="1">
          <Setter Property="Background" Value="#F8F8F8"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="LabelBox" TargetType="TextBox" BasedOn="{StaticResource CellBox}">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#000000"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="BorderBrush" Value="#B8BCC6"/>
      <Setter Property="Margin" Value="4,2"/>
      <Style.Triggers>
        <Trigger Property="h:OutputMode.IsActive" Value="True"><Setter Property="BorderThickness" Value="0"/></Trigger>
      </Style.Triggers>
    </Style>
    <DataTemplate x:Key="SizeRow" DataType="{x:Type m:SizeEntry}">
      <Border Style="{StaticResource RowBorder}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="7*"/></Grid.ColumnDefinitions>
          <Grid Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
            <TextBlock Style="{StaticResource SizeLabel}" Text="{Binding Label}" Visibility="{Binding IsCustom, Converter={StaticResource InvBoolToVis}}"/>
            <!-- optional sizes (bottoms): the size itself is typed in -->
            <TextBox Style="{StaticResource LabelBox}" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" ToolTip="Type the size (e.g. 5XL, 28, 30, K-M)"
                     Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"/>
          </Grid>
          <Grid Grid.Column="1" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
            <TextBox Style="{StaticResource CellBox}" Text="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}" Validation.ErrorTemplate="{x:Null}"/>
            <!-- After Submit the sleeve type is printed next to each quantity -->
            <TextBlock Text="{Binding SleeveTag}" FontSize="7.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                       Visibility="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InvBoolToVis}}"/>
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>
    <ItemsPanelTemplate x:Key="RowsPanel"><UniformGrid Columns="1" Rows="{Binding DataContext.SizeRowCount, RelativeSource={RelativeSource AncestorType=UserControl}}"/></ItemsPanelTemplate>
  </UserControl.Resources>

  <Border Style="{StaticResource Card}" CornerRadius="9">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource AccentTintBrush}" CornerRadius="9,9,0,0"/>

      <!-- Adults (S/S) | Adults (L/S) | Kids (S/S) | PS (S/S) - the last column appears with "+ PS sizes".
           The adult headers are two small drop-downs: category (Adults / Unisex / Gents / Lads) and sleeve (S/S / L/S).
           On the submitted sheet columns without quantities are left out and the rest share the width. -->
      <ItemsControl Grid.RowSpan="2" ItemsSource="{Binding SizeColumnsView}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type m:SizeColumn}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Border BorderBrush="White" BorderThickness="0,0,1,0">
                <Grid>
                  <!-- plain header: Kids / PS / Optional columns always; the adult columns on the submitted sheet, print and PDF -->
                  <TextBlock Text="{Binding Header}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource TableHeader}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsAdult}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                          <Trigger Property="h:OutputMode.IsActive" Value="True"><Setter Property="Visibility" Value="Visible"/></Trigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <!-- adult columns while editing: category and sleeve drop-downs -->
                  <Viewbox StretchDirection="DownOnly" Margin="2,0">
                    <Viewbox.Style>
                      <Style TargetType="Viewbox">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding IsAdult}" Value="True"/>
                              <Condition Binding="{Binding Path=(h:OutputMode.IsActive), RelativeSource={RelativeSource Self}}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                          </MultiDataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Viewbox.Style>
                    <StackPanel Orientation="Horizontal">
                      <ComboBox Style="{StaticResource FlatCombo}" FontSize="12" FontWeight="Bold" Foreground="#000000" MinWidth="40"
                                ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" ToolTip="Garment category: Adults, Unisex, Gents or Lads"/>
                      <!-- sleeve part (not on bottoms / shorts) -->
                      <StackPanel Orientation="Horizontal" Visibility="{Binding HasSleeve, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="(" FontSize="12" FontWeight="Bold" Foreground="#000000" VerticalAlignment="Center"/>
                        <ComboBox Style="{StaticResource FlatCombo}" FontSize="12" FontWeight="Bold" Foreground="#000000" MinWidth="26"
                                  ItemsSource="{Binding Sleeves}" SelectedItem="{Binding Sleeve}" ToolTip="Sleeve type: S/S (short sleeve) or L/S (long sleeve)"/>
                        <TextBlock Text=")" FontSize="12" FontWeight="Bold" Foreground="#000000" VerticalAlignment="Center"/>
                      </StackPanel>
                    </StackPanel>
                  </Viewbox>
                  <!-- "Optional sizes" column: + adds another row -->
                  <Button Content="+" Width="16" Height="16" FontSize="11" HorizontalAlignment="Right" Margin="0,0,4,0" Command="{Binding AddRowCommand}"
                          ToolTip="Add another optional size row">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding CanAddRows}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                          <Trigger Property="h:OutputMode.IsActive" Value="True"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </Grid>
              </Border>
              <ItemsControl Grid.Row="1" ItemsSource="{Binding View}" ItemTemplate="{StaticResource SizeRow}" ItemsPanel="{StaticResource RowsPanel}" AlternationCount="2"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Grid.Row="2" Background="{DynamicResource AccentBrush}" CornerRadius="0,0,9,9">
        <Grid>
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="ExtraBold" Foreground="{DynamicResource OnAccentBrush}">
            <Run Text="Total:  "/><Run Text="{Binding TotalQuantity, Mode=OneWay}"/>
          </TextBlock>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0"
                      Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}">
            <!-- jackets and bottoms: Kids column is optional; bottoms: PS column too -->
            <ToggleButton Style="{StaticResource PillToggle}" Content="+ Kids" Width="52" Height="16" FontSize="8.5" Margin="0,0,4,0"
                          IsChecked="{Binding IncludeKids, Mode=TwoWay}" ToolTip="Add the Kids column (K3XS to K3XL)"
                          Visibility="{Binding ShowKidsToggle, Converter={StaticResource BoolToVis}}"/>
            <ToggleButton Style="{StaticResource PillToggle}" Content="+ PS" Width="44" Height="16" FontSize="8.5" Margin="0,0,4,0"
                          IsChecked="{Binding IncludeBottomPs, Mode=TwoWay}" ToolTip="Add the pre-school column (P4XS to PXL)"
                          Visibility="{Binding IsBottoms, Converter={StaticResource BoolToVis}}"/>
            <ToggleButton Style="{StaticResource PillToggle}" Content="{Binding ExtraSizesText}" Width="72" Height="16" FontSize="8.5"
                          IsChecked="{Binding IncludeExtraSizes, Mode=TwoWay}" ToolTip="{Binding ExtraSizesTip}"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
