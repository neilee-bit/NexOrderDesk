<UserControl x:Class="NexOrderDesk.Views.Sections.ActionBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:NexOrderDesk.Views.Sections" xmlns:m="clr-namespace:NexOrderDesk.Models">
  <Grid>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <Button Style="{StaticResource ActionButton}" Width="132" Margin="0,0,10,0" Content="{Binding FlipText}"
              Command="{Binding FlipCommand}" ToolTip="Flip the sheet to its other side"/>
      <!-- Print / PDF appear only once the order is submitted (hidden while creating or editing) -->
      <Button x:Name="PrintButton" Style="{StaticResource ActionButton}" Width="96" Margin="0,0,10,0" Content="&#x1F5A8;  Print" Command="{Binding PrintCommand}"
              Visibility="{Binding IsEditable, Converter={StaticResource InvBoolToVis}}"
              ToolTip="Print with preview: single A4, two copies, double-sided, A5 or half A4 (Ctrl+P)"/>
      <Button x:Name="PdfButton" Style="{StaticResource ActionButton}" Width="96" Margin="0,0,10,0" Content="&#x1F4C4;  PDF" Command="{Binding PdfCommand}"
              Visibility="{Binding IsEditable, Converter={StaticResource InvBoolToVis}}"
              ToolTip="Save as PDF with the same layouts and an A4 preview"/>
      <Button Style="{StaticResource PrimaryButton}" Width="104" Margin="0,0,10,0" Content="&#x2714;  Submit"
              Command="{Binding SubmitCommand}" ToolTip="Lock the sheet and save its PDF to Documents\NexOrderDesk Orders automatically"/>
      <Button Style="{StaticResource ActionButton}" Width="92" Content="&#x270E;  Edit"
              Command="{Binding EditCommand}" ToolTip="Unlock the sheet for editing"/>
    </StackPanel>

  </Grid>
</UserControl>
