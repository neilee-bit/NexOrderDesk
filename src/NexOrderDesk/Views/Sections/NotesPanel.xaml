<UserControl x:Class="NexOrderDesk.Views.Sections.NotesPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:NexOrderDesk.Views.Sections" xmlns:m="clr-namespace:NexOrderDesk.Models">
  <Grid>
    <Border Margin="0,13,0,0" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}" Background="White"
            Effect="{StaticResource SoftShadow}">
      <!-- no scroll bars: the text shrinks (13 down to 7.5) so everything fits inside the box -->
      <TextBox x:Name="Box" Style="{StaticResource NotesBox}" Margin="4,16,4,4" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
               VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" TextChanged="OnTextChanged" SizeChanged="OnSizeChanged"/>
    </Border>
    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Height="26" Padding="10,0,22,0"
            Background="{DynamicResource AccentBrush}" CornerRadius="9,13,13,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Viewbox Width="15" Height="15" Margin="0,0,6,0">
          <Path Data="M5,3 H19 V21 H5 Z M8,8 H16 M8,12 H16 M8,16 H13" Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="1.8" StrokeLineJoin="Round"/>
        </Viewbox>
        <TextBlock Text="SPECIAL NOTES:" FontSize="15" FontWeight="ExtraBold" Foreground="{DynamicResource OnAccentBrush}"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
