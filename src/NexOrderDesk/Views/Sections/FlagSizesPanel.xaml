<UserControl x:Class="NexOrderDesk.Views.Sections.FlagSizesPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:NexOrderDesk.Views.Sections" xmlns:m="clr-namespace:NexOrderDesk.Models" xmlns:h="clr-namespace:NexOrderDesk.Core">
  <!-- FLAGS: several sizes per order (2.9.1: compact column on the right, highlighted lines, big numbers). Each line: width x height (ft / in), single / double sided, quantity. -->
  <UserControl.Resources>
    <Style x:Key="Seg" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#1E1E1E"/><Setter Property="Height" Value="18"/><Setter Property="Padding" Value="8,0"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="White" BorderBrush="#C9CDD4" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}" Margin="0,0,2,0">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentDarkBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#6B7280"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="NumBox" TargetType="TextBox" BasedOn="{StaticResource CellBox}">
      <Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="ExtraBold"/><Setter Property="Foreground" Value="#111111"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#B8BCC6"/><Setter Property="Margin" Value="1,3"/>
      <Style.Triggers><Trigger Property="h:OutputMode.IsActive" Value="True"><Setter Property="BorderThickness" Value="0"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="EditOnly" TargetType="FrameworkElement">
      <Style.Triggers><Trigger Property="h:OutputMode.IsActive" Value="True"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="OutputOnly" TargetType="TextBlock">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers><Trigger Property="h:OutputMode.IsActive" Value="True"><Setter Property="Visibility" Value="Visible"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="ColHead" TargetType="TextBlock">
      <Setter Property="FontSize" Value="9.5"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#4B5563"/>
      <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </UserControl.Resources>

  <Border Style="{StaticResource Card}">
    <DockPanel>
      <!-- header: title + unit switch -->
      <Border DockPanel.Dock="Top" Height="28" Background="{DynamicResource AccentTintBrush}" CornerRadius="9,9,0,0" Padding="10,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="UNIT" FontSize="9" FontWeight="Bold" Foreground="#1E1E1E" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <StackPanel Orientation="Horizontal" Style="{StaticResource EditOnly}">
              <ToggleButton Style="{StaticResource Seg}" Content="ft" IsChecked="{Binding IsFeet, Mode=TwoWay}" ToolTip="Feet"/>
              <ToggleButton Style="{StaticResource Seg}" Content="in" IsChecked="{Binding IsInches, Mode=TwoWay}" ToolTip="Inches"/>
            </StackPanel>
            <TextBlock Style="{StaticResource OutputOnly}" Text="{Binding FlagUnitText}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="FLAG SIZES" FontSize="13" FontWeight="ExtraBold" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <!-- footer: add size + total -->
      <Border DockPanel.Dock="Bottom" Height="28" Background="{DynamicResource AccentBrush}" CornerRadius="0,0,9,9" Padding="8,0">
        <Grid>
          <Button HorizontalAlignment="Left" Style="{StaticResource ActionButton}" Height="18" FontSize="10" Padding="8,0" Content="+ Add size"
                  Command="{Binding AddFlagSizeCommand}" ToolTip="Add another flag size (up to 10)"
                  Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}"/>
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="ExtraBold" Foreground="{DynamicResource OnAccentBrush}">
            <Run Text="Total flags:  "/><Run Text="{Binding FlagTotal, Mode=OneWay}"/>
          </TextBlock>
        </Grid>
      </Border>

      <!-- column titles -->
      <Grid DockPanel.Dock="Top" Height="18" Margin="10,2,10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/>
          <ColumnDefinition Width="80"/><ColumnDefinition Width="46"/><ColumnDefinition Width="18"/>
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource ColHead}" Text="WIDTH"/>
        <TextBlock Grid.Column="2" Style="{StaticResource ColHead}" Text="HEIGHT"/>
        <TextBlock Grid.Column="4" Style="{StaticResource ColHead}" Text="SIDES"/>
        <TextBlock Grid.Column="5" Style="{StaticResource ColHead}" Text="QTY"/>
      </Grid>

      <!-- size lines -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8,0,8,4">
        <ItemsControl ItemsSource="{Binding FlagSizesView}" AlternationCount="2">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type m:FlagSizeEntry}">
              <!-- 2.9.1: every filled size line is highlighted (accent tint), numbers big and bold -->
              <Border Height="32" CornerRadius="8" Margin="0,2" Padding="2,0">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="#F6F7F9"/><Setter Property="BorderBrush" Value="#E3E5EA"/><Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasContent}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentTintBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="80"/><ColumnDefinition Width="46"/><ColumnDefinition Width="18"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Style="{StaticResource NumBox}" Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Width"/>
                  <TextBlock Grid.Column="1" Text="&#x00D7;" FontSize="15" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <TextBox Grid.Column="2" Style="{StaticResource NumBox}" Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Height"/>
                  <TextBlock Grid.Column="3" Text="{Binding DataContext.FlagUnit, RelativeSource={RelativeSource AncestorType=s:FlagSizesPanel}}"
                             FontSize="11" FontWeight="Bold" Foreground="#374151" VerticalAlignment="Center"/>
                  <Viewbox Grid.Column="4" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource EditOnly}">
                    <StackPanel Orientation="Horizontal">
                      <ToggleButton Style="{StaticResource Seg}" Content="Single" IsChecked="{Binding IsSingleSided, Mode=TwoWay}" FontSize="9" Padding="5,0"/>
                      <ToggleButton Style="{StaticResource Seg}" Content="Double" IsChecked="{Binding IsDoubleSided, Mode=TwoWay}" FontSize="9" Padding="5,0"/>
                    </StackPanel>
                  </Viewbox>
                  <Viewbox Grid.Column="4" StretchDirection="DownOnly" Margin="2,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Visibility, ElementName=SidesOut}">
                    <TextBlock x:Name="SidesOut" Style="{StaticResource OutputOnly}" Text="{Binding SidesText}" FontSize="11" FontWeight="Bold"/>
                  </Viewbox>
                  <TextBox Grid.Column="5" Style="{StaticResource NumBox}" Text="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}" Validation.ErrorTemplate="{x:Null}" ToolTip="Quantity"/>
                  <Button Grid.Column="6" Content="&#x2715;" Width="16" Height="16" FontSize="8" Padding="0" ToolTip="Remove this size"
                          CommandParameter="{Binding}" Command="{Binding DataContext.RemoveFlagSizeCommand, RelativeSource={RelativeSource AncestorType=s:FlagSizesPanel}}">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                        <Style.Triggers><Trigger Property="h:OutputMode.IsActive" Value="True"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
