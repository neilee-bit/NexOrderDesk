<UserControl x:Class="NexOrderDesk.Views.Sections.MaterialColorBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:NexOrderDesk.Views.Sections" xmlns:m="clr-namespace:NexOrderDesk.Models" xmlns:h="clr-namespace:NexOrderDesk.Core">
  <!-- Material gets the free width (full name shown, shrinks only if very long); colour is packed to the right end.
       Bottoms / shorts / flags: taller row and a bigger colour picker. Flags: bar on top of the sheet, rows side by side (two per line from 3 rows), bigger material name. -->
  <UserControl.Resources>
    <h:AtLeastConverter x:Key="AtLeast3" Min="3"/>
    <ItemsPanelTemplate x:Key="Stacked"><StackPanel/></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="SideBySide"><UniformGrid Rows="1"/></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="TwoPerLine"><UniformGrid Columns="2"/></ItemsPanelTemplate>
  </UserControl.Resources>
  <ItemsControl ItemsSource="{Binding MaterialColors}" Margin="0,0,0,-3">
    <ItemsControl.Style>
      <Style TargetType="ItemsControl">
        <Setter Property="ItemsPanel" Value="{StaticResource Stacked}"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsFlags}" Value="True"><Setter Property="ItemsPanel" Value="{StaticResource SideBySide}"/></DataTrigger>
          <!-- flags (2.9.1): bar is on top of the sheet; 3 or 4 materials go two per line so every name stays readable -->
          <MultiDataTrigger>
            <MultiDataTrigger.Conditions>
              <Condition Binding="{Binding IsFlags}" Value="True"/>
              <Condition Binding="{Binding MaterialColors.Count, Converter={StaticResource AtLeast3}}" Value="True"/>
            </MultiDataTrigger.Conditions>
            <Setter Property="ItemsPanel" Value="{StaticResource TwoPerLine}"/>
          </MultiDataTrigger>
        </Style.Triggers>
      </Style>
    </ItemsControl.Style>
    <ItemsControl.ItemTemplate>
      <DataTemplate DataType="{x:Type m:MaterialColorEntry}">
        <Border Margin="0,0,3,3">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Card}">
              <Setter Property="Height" Value="28"/><Setter Property="CornerRadius" Value="14"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.ProminentColor, RelativeSource={RelativeSource AncestorType=s:MaterialColorBar}}" Value="True">
                  <Setter Property="Height" Value="34"/><Setter Property="CornerRadius" Value="17"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/>
              <ColumnDefinition Width="Auto"/><ColumnDefinition Width="1"/>
              <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource AccentBrush}" CornerRadius="14,16,16,14" Padding="9,0,12,0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                  <Path Data="M12,2 L2,7 L12,12 L22,7 Z M2,12 L12,17 L22,12 M2,17 L12,22 L22,17" Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="2" StrokeLineJoin="Round"/>
                </Viewbox>
                <TextBlock Text="{Binding PillTitle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}"/>
              </StackPanel>
            </Border>
            <ComboBox x:Name="MaterialName" Grid.Column="1" Margin="8,2,4,2"
                      h:ComboHelper.ManageKey="{Binding DataContext.MaterialManageKey, RelativeSource={RelativeSource AncestorType=s:MaterialColorBar}}"
                      HorizontalContentAlignment="Left" ToolTip="{Binding Material}"
                      ItemsSource="{Binding DataContext.MaterialOptions, RelativeSource={RelativeSource AncestorType=s:MaterialColorBar}}"
                      SelectedItem="{Binding Material}">
              <ComboBox.Style>
                <Style TargetType="ComboBox" BasedOn="{StaticResource FlatCombo}">
                  <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Bold"/>
                  <Style.Triggers>
                    <!-- flags (2.9.1): the flag material is the key spec - bigger, bolder name -->
                    <DataTrigger Binding="{Binding DataContext.IsFlags, RelativeSource={RelativeSource AncestorType=s:MaterialColorBar}}" Value="True">
                      <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="ExtraBold"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ComboBox.Style>
            </ComboBox>
            <Rectangle Grid.Column="2" Fill="{StaticResource LineBrush}" Margin="0,5"/>
            <!-- 2.9: free words between material and colour, e.g. FRONT & BACK (hidden on the submitted sheet when empty) -->
            <Grid Grid.Column="3" Margin="4,0" VerticalAlignment="Center">
              <Grid.Style>
                <Style TargetType="Grid">
                  <Setter Property="Width" Value="92"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.IsFlags, RelativeSource={RelativeSource AncestorType=s:MaterialColorBar}}" Value="True">
                      <Setter Property="Width" Value="80"/>
                    </DataTrigger>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasNote}" Value="False"/>
                        <Condition Binding="{Binding Path=(h:OutputMode.IsActive), RelativeSource={RelativeSource Self}}" Value="True"/>
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <Border CornerRadius="9" Background="#F3F4F6" Margin="0,3"/>
              <TextBox Style="{StaticResource ValueBox}" FontSize="11" FontWeight="Bold" CharacterCasing="Upper" TextAlignment="Center"
                       h:FitText.Enabled="True" h:FitText.MinSize="6" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Optional words for this material, e.g. FRONT &amp; BACK, SLEEVES, COLLAR"/>
              <Viewbox StretchDirection="DownOnly" Margin="4,0" IsHitTestVisible="False">
              <TextBlock Text="e.g. front &amp; back" FontSize="9.5" FontStyle="Italic" Foreground="#A0A4AE" IsHitTestVisible="False"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding HasNote}" Value="False"/>
                          <Condition Binding="{Binding Path=(h:OutputMode.IsActive), RelativeSource={RelativeSource Self}}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible"/>
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              </Viewbox>
            </Grid>
            <!-- colour (2.9.1, all order types): a plain text field like the material - default WHITE, type any colour name.
                 No swatches, colour circles or colour picker. -->
            <Grid Grid.Column="5" Margin="6,2,4,2" VerticalAlignment="Center">
              <Grid.Style>
                <Style TargetType="Grid">
                  <Setter Property="MinWidth" Value="110"/><Setter Property="MaxWidth" Value="190"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.IsFlags, RelativeSource={RelativeSource AncestorType=s:MaterialColorBar}}" Value="True">
                      <Setter Property="MinWidth" Value="90"/><Setter Property="MaxWidth" Value="160"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <Border CornerRadius="9" Background="#F3F4F6" Margin="0,1"/>
              <TextBox x:Name="PlainColour" Style="{StaticResource ValueBox}" FontSize="12" FontWeight="Bold" CharacterCasing="Upper" TextAlignment="Center"
                       h:FitText.Enabled="True" h:FitText.MinSize="6" Text="{Binding ColorName, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Colour - type any colour name (default WHITE)"/>
            </Grid>
            <Grid Grid.Column="6">
              <Grid.Style>
                <Style TargetType="Grid">
                  <Setter Property="Width" Value="24"/>
                  <Style.Triggers><Trigger Property="h:OutputMode.IsActive" Value="True"><Setter Property="Width" Value="8"/><Setter Property="Visibility" Value="Hidden"/></Trigger></Style.Triggers>
                </Style>
              </Grid.Style>
              <Button Content="+" Width="18" Height="18" Style="{StaticResource ActionButton}" FontSize="12" ToolTip="Add another material / colour"
                      Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVis}}"
                      Command="{Binding DataContext.AddMaterialCommand, RelativeSource={RelativeSource AncestorType=s:MaterialColorBar}}"/>
              <Button Content="&#x2212;" Width="18" Height="18" Style="{StaticResource ActionButton}" FontSize="12" ToolTip="Remove this row"
                      Visibility="{Binding IsPrimary, Converter={StaticResource InvBoolToVis}}" CommandParameter="{Binding}"
                      Command="{Binding DataContext.RemoveMaterialCommand, RelativeSource={RelativeSource AncestorType=s:MaterialColorBar}}"/>
            </Grid>
          </Grid>
        </Border>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
