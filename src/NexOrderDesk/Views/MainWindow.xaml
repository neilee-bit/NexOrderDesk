<Window x:Class="NexOrderDesk.Views.MainWindow" x:Name="RootWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:NexOrderDesk.Views.Sections" xmlns:m="clr-namespace:NexOrderDesk.Models" xmlns:vm="clr-namespace:NexOrderDesk.ViewModels" xmlns:h="clr-namespace:NexOrderDesk.Core"
        Title="{x:Static h:AppInfo.Title}" Icon="/Assets/app.ico" Width="1180" Height="860" MinWidth="760" MinHeight="560"
        Background="#2B2B2B" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" PreviewKeyDown="OnPreviewKeyDown" Loaded="OnLoaded">
  <Window.Resources>
    <!-- Each open order tab renders as an A5-landscape sheet: 840 x 592 design canvas (1 unit = 0.25 mm), scaled uniformly.
         A back side set to A4 portrait is 840 x 1188 (same scale). -->
    <DataTemplate DataType="{x:Type vm:OrderViewModel}">
      <!-- 2.9: thinner margin around the sheet = bigger sheet on screen -->
      <Viewbox Stretch="Uniform" Margin="8,6,8,6">
        <Border Width="840" Height="{Binding SheetHeight}" CornerRadius="4" Background="{DynamicResource SheetBrush}" Effect="{StaticResource SoftShadow}">
          <s:OrderSheetView/>
        </Border>
      </Viewbox>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#1A1A1A" Padding="10,5,10,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
          <!-- shown when the start-up check finds a newer version -->
          <Button x:Name="UpdatePill" Visibility="Collapsed" Click="OnUpdatePill" Cursor="Hand" Margin="0,0,8,0" ToolTip="See what's new and install the update">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border Background="{DynamicResource AccentBrush}" CornerRadius="12" Padding="10,3">
                  <ContentPresenter TextElement.FontSize="11" TextElement.FontWeight="Bold" TextElement.Foreground="{DynamicResource OnAccentBrush}"/>
                </Border>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <Button Style="{StaticResource ToolbarButton}" Content="&#x27F3;  Check for updates" Click="OnCheckUpdates" ToolTip="Check GitHub for a newer version of NEX ORDER DESK"/>
          <Button Style="{StaticResource ToolbarButton}" Content="Export options" Command="{Binding ExportCommand}" ToolTip="Back up option lists to a JSON file"/>
          <Button Style="{StaticResource ToolbarButton}" Content="Import options" Command="{Binding ImportCommand}" ToolTip="Restore option lists from a JSON file"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
          <TextBlock Text="{x:Static h:AppInfo.Title}" Foreground="White" FontSize="14" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="2,0,18,6"/>
          <ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                   ItemContainerStyle="{StaticResource TabItemStyle}" Background="Transparent" BorderThickness="0" Padding="0">
            <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          </ListBox>
          <ToggleButton x:Name="AddToggle" Content="+" Width="28" Height="26" FontSize="16" FontWeight="Bold" Foreground="White"
                        Background="#3A3A3A" BorderThickness="0" Cursor="Hand" VerticalAlignment="Bottom" Margin="2,0,0,2" ToolTip="New order (Ctrl+N)">
            <ToggleButton.Template>
              <ControlTemplate TargetType="ToggleButton">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#4A4A4A"/></Trigger></ControlTemplate.Triggers>
              </ControlTemplate>
            </ToggleButton.Template>
          </ToggleButton>
          <Popup IsOpen="{Binding IsChecked, ElementName=AddToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=AddToggle}"
                 Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="White" CornerRadius="8" Padding="4" Margin="0,4,10,10" Effect="{StaticResource SoftShadow}" MinWidth="190">
              <StackPanel>
                <TextBlock Text="NEW ORDER — choose type" FontSize="9" FontWeight="Bold" Foreground="#6B7280" Margin="12,6,0,4"/>
                <ItemsControl ItemsSource="{Binding OrderTypes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:OrderTypeDef}">
                      <Button Style="{StaticResource MenuRowButton}" Command="{Binding DataContext.NewOrderCommand, ElementName=RootWindow}"
                              CommandParameter="{Binding}" Click="OnNewType">
                        <StackPanel Orientation="Horizontal">
                          <Border Width="20" Height="20" CornerRadius="5" Background="{Binding Dot}" Margin="0,0,9,0">
                            <Viewbox Width="12" Height="12"><Grid><Path Data="{Binding Icon}" Fill="#1E1E1E" Visibility="{Binding NoIconImage, Converter={StaticResource BoolToVis}}"/>
              <Image Source="{Binding IconImage}" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasIconImage, Converter={StaticResource BoolToVis}}"/></Grid></Viewbox>
                          </Border>
                          <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border BorderBrush="#E5E5E5" BorderThickness="0,1,0,0" Margin="6,4,6,0" Padding="0,4,0,0">
                  <Button Style="{StaticResource MenuRowButton}" Click="OnManageTypes" ToolTip="Add your own order types and change any type's theme colour">
                    <TextBlock Text="+ Add / edit order types &amp; colours…" FontSize="11" FontWeight="SemiBold" Foreground="#2468C2"/>
                  </Button>
                </Border>
              </StackPanel>
            </Border>
          </Popup>
        </StackPanel>
      </DockPanel>
    </Border>
    <ContentControl Grid.Row="1" Content="{Binding SelectedTab}"/>
    <TextBlock Grid.Row="1" Text="Press  +  to start a new order" Foreground="#9A9A9A" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
               Visibility="{Binding HasNoTabs, Converter={StaticResource BoolToVis}}"/>
  </Grid>
</Window>
