<Window x:Class="NexOrderDesk.Views.UpdateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Software update" Width="560" Height="560" MinWidth="480" MinHeight="420" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" Background="#F4F5F7" FontFamily="Segoe UI" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="DlgButton" TargetType="Button">
      <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="14,0"/><Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#1E1E1E"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="White"/><Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="#D9DCE1" BorderThickness="1" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#9AA0A9"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource DlgButton}">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
    </Style>
    <Style x:Key="Key" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#6B7280"/><Setter Property="Margin" Value="0,3,14,3"/></Style>
    <Style x:Key="Val" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,3"/></Style>
    <Style x:Key="Big" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Body" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="#374151"/><Setter Property="LineHeight" Value="18"/></Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <Border Background="{DynamicResource AccentBrush}" Padding="16,12">
      <StackPanel>
        <TextBlock Text="Software update" FontSize="17" FontWeight="ExtraBold" Foreground="{DynamicResource OnAccentBrush}"/>
        <TextBlock x:Name="HeaderText" FontSize="11" Foreground="{DynamicResource OnAccentBrush}" Opacity="0.75" Margin="0,2,0,0"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Margin="18,14,18,8">
      <!-- checking -->
      <StackPanel x:Name="PanelChecking" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource Big}" Text="Checking GitHub for updates…" HorizontalAlignment="Center"/>
        <ProgressBar IsIndeterminate="True" Height="6" Margin="40,14,40,0"/>
      </StackPanel>

      <!-- up to date / message / error -->
      <StackPanel x:Name="PanelMessage" VerticalAlignment="Center" Visibility="Collapsed">
        <TextBlock x:Name="MessageIcon" FontSize="40" HorizontalAlignment="Center" Text="&#x2714;"/>
        <TextBlock x:Name="MessageTitle" Style="{StaticResource Big}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,6"/>
        <TextBlock x:Name="MessageText" Style="{StaticResource Body}" HorizontalAlignment="Center" TextAlignment="Center"/>
      </StackPanel>

      <!-- update available -->
      <Grid x:Name="PanelAvailable" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Style="{StaticResource Big}" Text="A new version is available"/>
        <Grid Grid.Row="1" Margin="0,8,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <TextBlock Style="{StaticResource Key}" Text="Installed version"/>
          <TextBlock Grid.Column="1" Style="{StaticResource Val}" x:Name="CurrentText"/>
          <TextBlock Grid.Row="1" Style="{StaticResource Key}" Text="New version"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Val}" x:Name="NewText" Foreground="#0F7B3F"/>
          <TextBlock Grid.Row="2" Style="{StaticResource Key}" Text="Release date"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Val}" x:Name="DateText"/>
        </Grid>
        <DockPanel Grid.Row="2">
          <TextBlock DockPanel.Dock="Top" Text="WHAT'S NEW" FontSize="10" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,4"/>
          <TextBox x:Name="NotesBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="12"
                   BorderBrush="#D9DCE1" Background="White" Padding="8,6"/>
        </DockPanel>
      </Grid>

      <!-- download / verify / ready -->
      <StackPanel x:Name="PanelProgress" VerticalAlignment="Center" Visibility="Collapsed">
        <TextBlock x:Name="ProgressTitle" Style="{StaticResource Big}" Text="Downloading the update…"/>
        <ProgressBar x:Name="Bar" Height="12" Margin="0,12,0,6" Maximum="100"/>
        <TextBlock x:Name="ProgressText" Style="{StaticResource Body}"/>
        <TextBlock x:Name="ReadyText" Style="{StaticResource Body}" Margin="0,12,0,0" Visibility="Collapsed"
                   Text="When you click &quot;Install now&quot;: NEX ORDER DESK closes, Windows asks for permission, a small progress window shows the installation, then NEX ORDER DESK starts again by itself. Your settings, option lists, order types, icons and saved PDFs are kept. Open orders that are not submitted will be closed - submit them first."/>
      </StackPanel>
    </Grid>

    <DockPanel Grid.Row="2" Margin="18,6,18,14">
      <CheckBox x:Name="AutoCheck" DockPanel.Dock="Top" Margin="0,0,0,10" FontSize="11.5" Content="Check for updates automatically when NEX ORDER DESK starts"
                Checked="OnAutoCheckChanged" Unchecked="OnAutoCheckChanged"/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="SkipBtn" Style="{StaticResource DlgButton}" Content="Skip this version" Click="OnSkip" Visibility="Collapsed"/>
        <Button x:Name="PageBtn" Style="{StaticResource DlgButton}" Content="Release page" Click="OnReleasePage" Visibility="Collapsed"/>
        <Button x:Name="RetryBtn" Style="{StaticResource DlgButton}" Content="Try again" Click="OnRetry" Visibility="Collapsed"/>
        <Button x:Name="DownloadBtn" Style="{StaticResource Primary}" Content="&#x2B07;  Download and Install Update" Click="OnDownload" Visibility="Collapsed"/>
        <Button x:Name="InstallBtn" Style="{StaticResource Primary}" Content="Install now and restart" Click="OnInstall" Visibility="Collapsed"/>
        <Button x:Name="CloseBtn" Style="{StaticResource DlgButton}" Content="Close" IsCancel="True" Click="OnClose"/>
      </StackPanel>
      <TextBlock x:Name="VersionFoot" VerticalAlignment="Center" FontSize="10.5" Foreground="#9AA0A9"/>
    </DockPanel>
  </Grid>
</Window>
