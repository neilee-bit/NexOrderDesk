<Application x:Class="NexOrderDesk.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- the main window is opened in App.xaml.cs (OnStartup), so the self-test can run without it -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Index 0 is the active category theme; ThemeService swaps it at runtime. -->
        <ResourceDictionary Source="Themes/Theme.TShirt.xaml"/>
        <ResourceDictionary Source="Themes/Base.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
