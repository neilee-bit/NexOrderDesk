<Window x:Class="NexOrderDeskSetup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEX ORDER DESK Setup" Icon="/Assets/app.ico"
        Width="500" Height="360" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display"
        MouseLeftButtonDown="OnDrag" Loaded="OnLoaded" Closing="OnClosing">
  <Border Margin="14" CornerRadius="10" Background="White" BorderBrush="#DDDDDD" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" />
    </Border.Effect>
    <Grid>
      <!-- top-right buttons -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0">
        <Button x:Name="MinButton" Content="&#x2013;" ToolTip="Minimise" Click="OnMinimise" Width="30" Height="26"
                Background="Transparent" BorderThickness="0" Foreground="#888888" FontSize="15" Cursor="Hand" />
        <Button x:Name="CloseButton" Content="&#x2715;" ToolTip="Cancel" Click="OnCloseClick" Width="30" Height="26"
                Background="Transparent" BorderThickness="0" Foreground="#888888" FontSize="13" Cursor="Hand" />
      </StackPanel>

      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
        <Image Source="/Assets/logo.png" Width="92" Height="92" RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock Text="NEX ORDER DESK" FontSize="21" FontWeight="Bold" Foreground="#1E1E1E"
                   HorizontalAlignment="Center" Margin="0,12,0,0" />
        <TextBlock x:Name="StatusText" Text="Getting ready..." FontSize="14" Foreground="#333333"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0" />
        <ProgressBar x:Name="Bar" Style="{StaticResource SlimBar}" Width="300" Margin="0,12,0,0" IsIndeterminate="True"
                     Minimum="0" Maximum="1" />
        <TextBlock x:Name="DetailText" FontSize="11.5" Foreground="#808080" HorizontalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" MinHeight="16" />

        <StackPanel x:Name="ActionPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed">
          <Button x:Name="RetryButton" Content="Try again" Style="{StaticResource PrimaryButton}" Click="OnRetry" />
          <Button x:Name="LogButton" Content="Show details" Style="{StaticResource SecondaryButton}" Click="OnShowLog" />
          <Button x:Name="ExitButton" Content="Close" Style="{StaticResource SecondaryButton}" Click="OnExit" />
        </StackPanel>
      </StackPanel>

      <TextBlock x:Name="VersionText" FontSize="10.5" Foreground="#AAAAAA" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,8" />
      <TextBlock Text="Promotees Group" FontSize="10.5" Foreground="#AAAAAA" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,8" />
    </Grid>
  </Border>
</Window>
